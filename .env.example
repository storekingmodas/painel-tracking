# ============================================================
# Variáveis de ambiente: as quatro que todo deploy precisa
# ============================================================
# Na Vercel: Settings → Environment Variables. Cole o bloco inteiro no
# primeiro campo, já preenchido; a Vercel separa uma por linha.
# Para rodar na sua máquina: copie este arquivo para .env.local e preencha.
# O .env.local está no .gitignore e nunca vai para o GitHub.
#
# As opcionais (CRON_SECRET, ENCRYPTION_KEY) estão no README, em "Opcionais".

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Supabase → Project Settings → API Keys → aba "Legacy API Keys" → anon public
SUPABASE_ANON_KEY=

# Mesma tela → service_role (clique em "Reveal").
# SECRETA: abre o banco inteiro. Só aqui e na Vercel, nunca no código.
SUPABASE_SERVICE_ROLE_KEY=

# O seu e-mail, o mesmo do usuário criado no Supabase. Quem estiver aqui
# cria os outros usuários em Configurações. Vários: separe por vírgula.
ADMIN_EMAILS=voce@seudominio.com.br
